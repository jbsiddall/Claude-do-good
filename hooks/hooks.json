{
  "description": "Warn at session start if TAVILY_API_KEY missing, so Tavily MCP server does not fail silently. Append every markdown file in session-start-appends/ to session context. Remind parent when a finished subagent left work in a worktree.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "deno run --allow-env \"${CLAUDE_PLUGIN_ROOT}/scripts/check-tavily-key.ts\""
          },
          {
            "type": "command",
            "command": "deno run --allow-read=\"${CLAUDE_PLUGIN_ROOT}\" \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start-appends.ts\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "deno run --allow-run=git \"${CLAUDE_PLUGIN_ROOT}/scripts/worktree-reminder.ts\""
          }
        ]
      }
    ]
  }
}
