{
  "description": "Warn at session start if TAVILY_API_KEY is missing, so the Tavily MCP server doesn't fail silently. Also inject every rule in rules/ into the session.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "deno run --allow-env \"${CLAUDE_PLUGIN_ROOT}/scripts/check-tavily-key.ts\""
          },
          {
            "type": "command",
            "command": "deno run --allow-read=.,\"${CLAUDE_PLUGIN_ROOT}\" \"${CLAUDE_PLUGIN_ROOT}/scripts/session-rules.ts\""
          }
        ]
      }
    ]
  }
}
