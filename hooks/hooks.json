{
  "description": "Warn at session start if TAVILY_API_KEY missing, so Tavily MCP server does not fail silently. Append every markdown file in session-start-appends/ to session context.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "deno run --allow-env \"${CLAUDE_PLUGIN_ROOT}/scripts/check-tavily-key.ts\""
          },
          {
            "type": "command",
            "command": "deno run --allow-read=\"${CLAUDE_PLUGIN_ROOT}\" \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start-appends.ts\""
          }
        ]
      }
    ]
  }
}
